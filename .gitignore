.DS_Store
.worktrees/
*__pycache__/
*.pyc
builds/
*.pytest_cache*/*

# Secrets and local environment
.env
.env.*
!.env.example
*.local.json

# MCP configs that may carry tokens (per pr-review/SETUP.md guidance) — safe to commit only if you
# intentionally strip credentials first.
.cursor/mcp.json
.mcp.json

# Python virtualenvs / caches
.venv/
venv/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build/dist artifacts
dist/
build/

# architecture-review skill output. The skill writes its report to this exact repo-root path
# (see skills/architecture-review/workflow/report.md), so running it against this repository would
# otherwise overwrite a committed file. Dated historical runs live in docs/history/ instead.
/ARCHITECTURE_REVIEW_REPORT.md

# Agent-driven-development scratch/task-report output (e.g. the superpowers skill's SDD
# convention). Working-tree scratch space, not a deliverable -- a prior pass (PR #201)
# accidentally committed one run's reports (removed as stale/unreferenced in a later pass);
# this keeps a future run's reports from being recommitted the same way.
/.superpowers/

# graphify skill output: locally-generated knowledge graph (cache, graph.json/html, report).
# Regenerate with `graphify update .` -- not a deliverable, and the cache alone runs ~19M.
/graphify-out/

# cli/ (the sb package): build-time-populated snapshot directories, never committed
cli/sb/_vendored/
cli/sb/_registry_snapshot/
cli/dist/
cli/build/
cli/*.egg-info/
